{
  "manifest_version": 3,
  "name": "NVVSR mpv handoff",
  "version": "0.1.0",
  "description": "Hands fullscreen web videos to mpv with NVIDIA video super resolution. Needs the nvvsr native host.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "*://vimeo.com/*",
    "*://twitch.tv/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NVVSR mpv handoff"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtu.be/*",
        "*://vimeo.com/*",
        "*://twitch.tv/*"
      ],
      "js": [
        "lib/logic.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
