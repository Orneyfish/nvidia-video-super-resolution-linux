#!/bin/bash
# Ask a local Ollama model one question and print the answer.
# usage: ask-local [--model M] [--system S] [--file F]... [--num-ctx N] "prompt"   (stdin is appended when piped)
# keep_alive=0 unloads the model right away: Ollama shares the 8 GB GPU with the super-resolution work.
set -euo pipefail
model=qwen2.5-coder:7b-64k system="" ctx=32768 files=()
while [ $# -gt 1 ]; do
  case $1 in
    --model) model=$2 ;; --system) system=$2 ;; --num-ctx) ctx=$2 ;; --file) files+=("$2") ;;
    *) echo "ask-local: unknown option $1" >&2; exit 2 ;;
  esac
  shift 2
done
[ $# -eq 1 ] || { echo 'usage: ask-local [--model M] [--system S] [--file F]... [--num-ctx N] "prompt"' >&2; exit 2; }
prompt=$1
for f in "${files[@]}"; do prompt+=$'\n--- '"$f"$' ---\n'"$(cat -- "$f")"; done
[ -t 0 ] || prompt+=$'\n--- stdin ---\n'"$(cat)"
jq -n --arg m "$model" --arg p "$prompt" --arg s "$system" --argjson c "$ctx" \
  '{model:$m, prompt:$p, system:$s, stream:false, keep_alive:0, options:{num_ctx:$c, temperature:0.2}}' |
  curl -sf --max-time 600 http://localhost:11434/api/generate -d @- | jq -r .response ||
  { echo "ask-local: cannot reach Ollama at localhost:11434 (start it with: ollama serve)" >&2; exit 1; }
